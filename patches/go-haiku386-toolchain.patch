--- /dev/null
+++ b/src/runtime/syscall8_haiku_386.go
@@ -0,0 +1,26 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package runtime
+
+import "unsafe"
+
+// syscall_sysvicall8 is syscall_sysvicall6 with eight argument words, which is
+// what asmsysvicall6 copies. A 64-bit C argument takes two words on 386, so
+// mmap (five words and an off_t) does not fit in six.
+//
+//go:nosplit
+//go:linkname syscall_sysvicall8
+//go:cgo_unsafe_args
+func syscall_sysvicall8(fn, nargs, a1, a2, a3, a4, a5, a6, a7, a8 uintptr) (r1, r2, err uintptr) {
+	call := libcall{
+		fn:   fn,
+		n:    nargs,
+		args: uintptr(unsafe.Pointer(&a1)),
+	}
+	entersyscallblock()
+	asmcgocall(unsafe.Pointer(&asmsysvicall6x), unsafe.Pointer(&call))
+	exitsyscall()
+	return call.r1, call.r2, call.err
+}
